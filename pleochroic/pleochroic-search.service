[Unit]
Description=Pleochroic Search (SearXNG fork — internal metasearch JSON API)
Documentation=https://github.com/searxng/searxng
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pleochroic-search
Group=pleochroic-search
WorkingDirectory=/opt/pleochroic-search/release

EnvironmentFile=/etc/pleochroic-search/secrets.env

Environment=PYTHONPATH=/opt/pleochroic-search/release
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

# The merged settings, regenerated on every start
RuntimeDirectory=pleochroic-search
RuntimeDirectoryMode=0750
Environment=SEARXNG_SETTINGS_PATH=/run/pleochroic-search/settings.yml
ExecStartPre=/opt/pleochroic-search/venv/bin/python3 /opt/pleochroic-search/release/pleochroic/merge_settings.py /etc/pleochroic-search/settings.yml /etc/pleochroic-search/settings.private.yml /run/pleochroic-search/settings.yml

Environment=GRANIAN_INTERFACE=wsgi
Environment=GRANIAN_HOST=127.0.0.1
Environment=GRANIAN_PORT=8888
Environment=GRANIAN_PROCESS_NAME=pleochroic-search
Environment=GRANIAN_WORKERS=2
Environment=GRANIAN_BLOCKING_THREADS=4
Environment=GRANIAN_WEBSOCKETS=false
ExecStart=/opt/pleochroic-search/venv/bin/granian searx.webapp:app

Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/pleochroic-search
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute stays off until curl_cffi is verified under it
RemoveIPC=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
